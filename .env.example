# Optional mobile endpoint; web calls its own /api/tutor on Vercel.
# EXPO_PUBLIC_TUTOR_API_URL=https://one-kids.vercel.app/api/tutor

# SERVER ONLY: add privately to Vercel Production, then redeploy.
# Never prefix these names with EXPO_PUBLIC_. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-5-5
TUTOR_DEFAULT_PROVIDER=openai
# Emergency switch: true turns the AI off (practice mode) without deleting the keys.
# TUTOR_DISABLED=true
# Optional extra web origins for a native/dev deployment, comma-separated.
# TUTOR_ALLOWED_ORIGINS=http://localhost:8102

# Real family accounts (public browser configuration):
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_APP_URL=https://one-kids.vercel.app
