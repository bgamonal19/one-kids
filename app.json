{
  "expo": {
    "name": "ONE KIDS",
    "slug": "one-kids",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onekids",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ONE KIDS usa la cámara para que el tutor IA vea tus tareas.",
        "NSPhotoLibraryUsageDescription": "ONE KIDS puede usar una foto de tu tarea para ayudarte."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3DB8E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7FBFD"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ONE KIDS usa la cámara para que el tutor IA vea tus tareas.",
          "photosPermission": "ONE KIDS puede usar una foto de tu tarea para ayudarte."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
