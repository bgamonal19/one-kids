{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/tutor.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/world-atlas/countries-*.json"
    },
    "api/tts.mjs": {
      "maxDuration": 30
    },
    "api/study.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/practice/:id",
      "destination": "/practice/[id]"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
